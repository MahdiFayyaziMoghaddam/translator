{
	"manifest_version": 3,
	"name": "Translator — En-Fa Translator",
	"short_name": "Translator",
	"version": "1.0.0",
	"description": "Fast English-Persian translator with auto-detect, powered by Gemini (gemini-3.5-flash-lite).",
	"action": {
		"default_popup": "popup/popup.html",
		"default_title": "Translator (Alt+Shift+T)",
		"default_icon": {
			"16": "assets/icon.png",
			"48": "assets/icon.png",
			"128": "assets/icon.png"
		}
	},
	"options_ui": {
		"page": "options/options.html",
		"open_in_tab": true
	},
	"background": {
		"service_worker": "background/background.js",
		"type": "module"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["content/content.js"],
			"run_at": "document_idle"
		}
	],
	"commands": {
		"_execute_action": {
			"suggested_key": {
				"default": "Ctrl+Shift+T",
				"mac": "Command+Shift+T"
			},
			"description": "Open Translator popup"
		}
	},
	"permissions": ["storage", "contextMenus", "activeTab"],
	"host_permissions": ["https://gemini-api-proxy-v1.vercel.app/*"],
	"icons": {
		"16": "assets/icon.png",
		"48": "assets/icon.png",
		"128": "assets/icon.png"
	}
}
